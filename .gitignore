# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/

# Test / coverage artifacts
.coverage
.pytest_cache/

# Build
build/
dist/
*.spec

# Project settings/logs
pink_robin_settings.json
PinkRobinEncoder_Logs/

# Binaries (not in source repo; CI downloads them).
# NOTE: ignore the *contents* (bin/*), not the directory itself, otherwise
# the ! exception below has no effect and the VMAF model is never tracked.
bin/*
!bin/vmaf_v0.6.1.json

# Local offline wheel cache (see pip troubleshooting)
wheels/

# Local tool downloads (gh CLI portable, etc. - fetched by scripts, never committed)
.tools/

# Archives
*.zip
*.tar.gz
*.7z

# Editor / tool config
opencode.json
.vscode/
.idea/
*.swp
*.swo
